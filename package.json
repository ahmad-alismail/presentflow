{
  "name": "presentflow",
  "productName": "PresentFlow",
  "version": "1.0.0",
  "description": "Presentation companion: listens while you present and shows what to say now, what comes next and what you have not covered yet.",
  "homepage": "https://ahmad-alismail.github.io/presentflow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmad-alismail/presentflow.git"
  },
  "main": "./out/main/index.js",
  "author": "Ahmad Alismail",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win",
    "calibrate": "node -e \"process.env.CALIBRATE=1;require('child_process').execSync('npx vitest run --silent=false',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  }
}
